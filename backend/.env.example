# Server-side API credentials. Enter real values only in a local .env file
# or the Netlify environment-variable dashboard.
GROQ_API_KEY=
KHAYA_API_KEY=
KHAYA_ASR_BASE_URL=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=PASTE_ESCAPED_PRIVATE_KEY_HERE

# Public Firebase Web App configuration. The Netlify build writes only these
# values into the browser's generated firebase-config.js file.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
